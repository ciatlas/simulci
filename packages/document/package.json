      "types": "./src/edits.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@ciatlas/core": "github:ciatlas/core#v2.5.0"
  }
}
