{
  "name": "simulci-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' --if-present run build",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "schemas": "tsx --conditions=source scripts/gen-schemas.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@ciatlas/core": "github:ciatlas/core#v2.5.0",
    "@simulci/engine": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fallow": "^3.33.1",
    "fast-check": "4.10.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
