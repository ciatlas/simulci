{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Files that something other than an import loads.
  "entry": [
    // Run by the CI and release workflows.
    "scripts/*.mjs",
    "scripts/*.ts",
    // Loaded by apps/web/index.html before the app's own module.
    "apps/web/public/*.js",
    // Run in Node by the browser pass (apps/web/e2e/simulate.spec.ts), for the plan it checks the page against.
    "apps/web/e2e/node-plan.ts",
    // Run in Node by apps/web/e2e/case.spec.ts: the copied case checked against TestFileSchema and run as `simulci test`.
    "apps/web/e2e/node-case.ts",
    // The docs pages, which apps/docs/lib/source.ts loads by glob (fumadocs-mdx).
    "apps/docs/content/**/*.mdx",
  ],
  // Vite serves apps/web/public at the site root, where index.html asks for it.
  "ignoreUnresolvedImports": ["/config.js", "/theme.js"],
  // The engine and the document model are libraries inside the workspace: what their entries export, and the members
  // of what they export, are their API for the CLI, the Action, the web app and the server.
  "publicPackages": ["@simulci/engine", "@simulci/document", "@simulci/node"],
  // The licence map: packages/* are MIT, apps/* are FSL-1.1-MIT, ee/* is commercial. MIT code never imports the
  // other two, and the document model (the builder's foundation) depends on nothing else in the repository.
  "boundaries": {
    "zones": [
      { "name": "engine", "patterns": ["packages/engine/**"] },
      { "name": "document", "patterns": ["packages/document/**"] },
      { "name": "node", "patterns": ["packages/node/**"] },
      { "name": "cli", "patterns": ["packages/cli/**"] },
      { "name": "action", "patterns": ["packages/action/**"] },
      { "name": "web", "patterns": ["apps/**"] },
      { "name": "ee", "patterns": ["ee/**"] },
    ],
    "rules": [
      { "from": "engine", "allow": [] },
      { "from": "document", "allow": [] },
      { "from": "node", "allow": ["engine"] },
      { "from": "cli", "allow": ["engine", "document", "node"] },
      { "from": "action", "allow": ["engine", "node"] },
      // The web app's tests check parity with the Node host (file discovery); the bundle check keeps node out of the page.
      // The docs' tests run the CLI's commands, so the flags and outputs the docs show are the CLI's.
      { "from": "web", "allow": ["engine", "document", "node", "cli"] },
      { "from": "ee", "allow": ["engine", "document", "web"] },
    ],
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["**/test/**"],
        "maxUnitSize": 500,
        "reason": "Test suites: a describe() block groups many it() cases and is long by design",
      },
      {
        "files": ["apps/web/src/**/*.tsx"],
        "maxCrap": 100,
        "reason": "React components are covered by the browser pass (Playwright, apps/web/e2e), not by unit tests; CRAP assumes none",
      },
      {
        "files": ["scripts/**"],
        "maxCrap": 100,
        "reason": "Operational scripts run against GitHub's API and have no unit coverage; CRAP assumes none, so any branching function would breach 30",
      },
    ],
  },
}
